# Backend Configuration
PORT=3001
NODE_ENV=development

# Database Configuration (SQLite)
# Local path for SQLite DB file
DB_STORAGE_PATH=./data/database.sqlite

# Secret that signs login tokens and password-reset codes. REQUIRED: the server refuses to start without it.
# Use a long random value, never a real secret in this file (copy this file to .env, which is git-ignored).
# generate with: openssl rand -base64 32
JWT_SECRET=

# --- Only needed when the frontend and API are on different addresses (e.g. a deployment) ---
# Address of the website allowed to call this API from a browser (comma separated for several). Set it in production.
# CORS_ORIGIN=https://your-app.vercel.app
# Address of this API as the browser sees it. Used when the frontend is BUILT (Vercel: a project environment variable).
# NEXT_PUBLIC_API_URL=https://your-api.up.railway.app
